// The anonymous build's Worker: the same as wrangler.jsonc, serving dist-anon/ (made by anon-build.js) instead of
// ../game. Setup and deploy steps: README.md in this folder, "An anonymous copy".
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "isekaid-into-prod",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist-anon",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only the API runs the script; every other request is a free static-asset hit.
    "run_worker_first": ["/api/*"]
  },
  // Workers AI, for the LLM answer checker (POST /api/grade). No API key: the binding is the account's own.
  "ai": { "binding": "AI" },
  // At most 20 grades a minute from one address, so a script can't spend the day's free allocation.
  "ratelimits": [
    { "name": "GRADE_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "SAVES", "class_name": "SaveSlot" },
      { "name": "LOBBIES", "class_name": "Directory" }
    ]
  },
  // SQLite-backed Durable Objects are the kind the Workers Free plan allows.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room", "SaveSlot", "Directory"] }
  ]
}
